# Copy to .env on the server. All SENSITIVE values belong here.
# NEVER commit .env.

# App credentials from developer.spotify.com (type "Server-side")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public hostname (your DDNS) that resolves to the machine running this stack.
# Two things MUST be kept in sync:
#   1) the hostname in ./Caddyfile (replace `your-hostname.tld` with this value)
#   2) this value
# The Spotify dashboard redirect URI you register must be:
#   https://<this-value>/callback
SPOTIFY_REDIRECT_HOST=your-hostname.tld
