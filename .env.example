# Copy to .env. NEVER commit .env.

# App credentials from developer.spotify.com (type: Server-side)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Full URL that Spotify will redirect to. MUST start with https:// and match
# the URL your reverse proxy exposes. Example (base path /lyrics):
SPOTIFY_REDIRECT_URI=https://your-public.hostname/lyrics/callback

# Base path served by the relay. Must match the prefix your reverse proxy forwards.
RELAY_BASE_PATH=/lyrics
