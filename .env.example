# Copy to .env on the server. All SENSITIVE values belong here.
# NEVER commit .env.

# App credentials from developer.spotify.com (type "Server-side")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must EXACTLY match the URI registered in developer.spotify.com
# (Spotify only accepts http://localhost... or HTTPS)
SPOTIFY_REDIRECT_URI=http://localhost:8899/callback

RELAY_ADDR=:8899
