# Copy to .env. NEVER commit .env.

# App credentials from developer.spotify.com (type: Server-side)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Full URL that Spotify will redirect to. MUST start with https:// and match
# the URL your reverse proxy exposes. Example (base path /lyrics):
SPOTIFY_REDIRECT_URI=https://your-public.hostname/lyrics/callback

# Base path served by the relay. Must match the prefix your reverse proxy forwards.
RELAY_BASE_PATH=/lyrics

# Optional: how often (ms) to re-check Spotify while clients hold a wait=1
# request. Default 300. No Spotify calls are made when nobody is waiting.
# RELAY_WAITS_REFRESH_MS=300

# --- Lyrics cache (all optional; defaults shown) ---------------------------
# Lifetime of a resolved lyric, in days. 0 = never expires.
# LYRICS_TTL_DAYS=365
# How long a "no lyrics" (404) result is remembered, in days. Memory only,
# never persisted — a song may gain lyrics later.
# LYRICS_TTL_NONE_DAYS=1
# Size cap (MB) of the on-disk lyrics cache; oldest files evicted first.
# 0 = unlimited.
# LYRICS_CACHE_MAX_MB=64
