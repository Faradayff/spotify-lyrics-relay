# Copiar a .env en el servidor. Todos los valores SENSIBLES van por aqui.
# NUNCA commitear .env.

# Credenciales de la App en developer.spotify.com (tipo "Server-side")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con la redir registrada en developer.spotify.com
# (Spotify solo acepta http://localhost... o HTTPS)
SPOTIFY_REDIRECT_URI=http://localhost:8899/callback

RELAY_ADDR=:8899
