# Caddyfile for the relay.
#
# - Edit the hostname below to match YOUR public hostname (e.g. your DDNS
#   subdomain: relay.yourdomain.com). It must match SPOTIFY_REDIRECT_HOST
#   in .env and the redirect URI you register on developer.spotify.com
#   (https://<this-hostname>/callback).
# - The `:443` and `:80` ports in docker-compose.yml must be forwarded
#   on your router to this machine (443/tcp for TLS, 80/tcp for Let's
#   Encrypt HTTP-01).
# - Caddy obtains a Let's Encrypt certificate automatically; it is cached
#   in the `caddy_data` named volume.
# - If your DDNS is a bare public IP (e.g. my.ddns.net -> 88.1.2.3), you
#   can use any subdomain of it as long as the DNS A/AAAA record points to
#   the box running this stack.

your-hostname.tld {
    encode gzip

    # Don't mangle the /status endpoint (which already returns proper headers);
    # just pass it through.
    reverse_proxy / relay:8899
}
